<UserControl x:Class="TerminalLab.Controls.Views.ControlledMethodButtonsView"
             x:Name="MethodButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TerminalLab.Controls.ViewModels"
             xmlns:local="clr-namespace:TerminalLab.Controls.Views"
             mc:Ignorable="d" 
           d:DataContext="{d:DesignInstance vm:ControlledMethodButtonsViewModel}"
             >
    <UserControl.Resources>
        <ResourceDictionary Source="../../StyleDictionary.xaml"/>
    </UserControl.Resources>
    <StackPanel >
        <ComboBox Height="25" 
                  ItemsSource="{Binding Controllers}" 
                  DisplayMemberPath="Name" 
                  SelectedItem="{Binding Device}" 
                  Style="{DynamicResource SelectedInputControllerComboBoxStyle}"
                  SelectionChanged="ComboBox_SelectionChanged"/>

        
        <WrapPanel x:Name="Panel" Orientation="Vertical" Height="100" />


    </StackPanel>

</UserControl>
