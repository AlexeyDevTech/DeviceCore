<UserControl x:Class="TerminalLab.Controls.Views.ControlledMethodButtonsView"
             x:Name="MethodButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TerminalLab.Controls.ViewModels"
             xmlns:local="clr-namespace:TerminalLab.Controls.Views"
             mc:Ignorable="d" 
           d:DataContext="{d:DesignInstance vm:ControlledMethodButtonsViewModel}"
             >
    <UserControl.Resources>
        <ResourceDictionary Source="../../StyleDictionary.xaml"/>
    </UserControl.Resources>
    <StackPanel >
        <ComboBox Height="25" ItemsSource="{Binding Controllers}" DisplayMemberPath="Name" SelectedItem="{Binding Device}" Style="{DynamicResource SelectedInputControllerComboBoxStyle}"/>

        <ItemsControl ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding MethodButtons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" Height="100"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">

                        <Button Height="25" Width="100" Content="{Binding Name}" Command="{Binding Command}" CommandParameter="{Binding Param}" />
                        <ComboBox Style="{DynamicResource ComboBoxUserControl}" Height="25" ItemsSource="{Binding Values}" SelectedItem="{Binding Param}"  IsEnabled="{Binding isEnum}" />
                        <TextBox Height="25" Style="{DynamicResource TextBoxUserControl}" Text="{Binding Param}" IsEnabled="{Binding isString}"/>
                    </StackPanel>

                </DataTemplate>

            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--<ItemsControl Height="100" ItemsSource="{Binding MethodButtons}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}" Command="{Binding Command}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>-->
    </StackPanel>

</UserControl>
